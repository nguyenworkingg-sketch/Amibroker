// =====================================================================
// Hub_Sectors.afl - BANG NGANH cho AmiBroker Exploration Hub
// Apply to: watchlist 63 (chi so nganh NGANH_*, tinh boi scripts\nganh.py). Moi phien trong Range = 1 dong.
// RS-Z / RS-Mom so voi VNINDEX lay tu PtktCompute() (PTKT_core.afl) - giong chart "2. RS-Z va RS-Mom".
// Goc RRG: Dan dat (Z>0, Mom>0) / Suy yeu (Z>0, Mom<=0) / Tut hau (Z<=0, Mom<=0) / Cai thien (Z<=0, Mom>0).
// =====================================================================
#include_once <PTKT_core.afl>
PtktCompute();
Filter = StrLeft(Name(), 6) == "NGANH_" AND NOT IsNull(PT_rsz);

SetOption("NoDefaultColumns", True);
AddTextColumn(Name(), "Ticker", 1.0);
AddColumn(DateNum(), "DateNum", 1.0);
AddColumn(C, "Close", 1.4);
AddColumn(PT_rsz, "RSZ", 1.3);
AddColumn(PT_rsm, "RSMom", 1.3);
AddColumn((C / Ref(C, -5) - 1) * 100, "Ret5Pct", 1.2);
AddColumn((C / Ref(C, -20) - 1) * 100, "Ret20Pct", 1.2);
AddColumn((C / Ref(C, -60) - 1) * 100, "Ret60Pct", 1.2);
AddColumn(PT_ex63 * 100, "ExcessVNI63Pct", 1.2);   // PT_ex63 la ty le -> %
